rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This database is a server-side implementation detail. Browser clients
    // authenticate against the legacy Identity Platform tenant, then call the
    // HTTPS API. Only Admin SDK service identities may access these documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
