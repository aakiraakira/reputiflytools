# Watchlist / Daily Digest generated artifacts and local operational data.
# Source HTML and deployment configuration remain tracked; these can always be
# regenerated with scripts/leads/generate-hosting.mjs.
firebase-leads/hosting/
.private-migration/
scripts/leads/input/
scripts/leads/output/
scripts/leads/*.local.csv
scripts/leads/*.local.tsv
scripts/leads/*.local.json

# Firebase and Node local state (never credentials, logs, builds, or coverage).
firebase-debug.log
firebase-debug.*.log
.firebase/
firebase-leads/functions/node_modules/
firebase-leads/functions/lib/
firebase-leads/functions/coverage/
firebase-leads/functions/.env
firebase-leads/functions/.env.*
!firebase-leads/functions/.env.example
firebase-leads/functions/.env.*.local
